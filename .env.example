# Copy to .env and fill in. Never commit .env.
APP_ENV=production              # development | testing | production
SECRET_KEY=change-me            # python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-too    # different value, 32+ bytes

DB_HOST=localhost
DB_PORT=3306
DB_USER=exodus_app              # least-privilege user, NOT root
DB_PASSWORD=change-me
DB_NAME=company_attendance
DB_POOL_MAX=10

# Local HTTP development only (production keeps both true):
# COOKIE_SECURE=false
# FORCE_HTTPS=false

REFRESH_TOKEN_HOURS=12
RESUBMIT_WINDOW_SECONDS=5
WALKIN_REQUIRES_APPROVAL=false
LOGIN_LIMIT=5 per minute
SCAN_LIMIT=30 per minute
RATE_LIMIT_DEFAULT=120 per minute
RATELIMIT_STORAGE_URI=memory://   # use redis://host:6379 with more than one gunicorn worker
TRUSTED_PROXIES=0                 # number of reverse proxies in front (nginx = 1)

AUTO_CHECKOUT_ENABLED=true        # close anyone still on site at the cutoff time
AUTO_CHECKOUT_TIME=23:00          # 24-hour HH:MM

NOTIFIER_BACKEND=log              # log | smtp | webhook   (use smtp to email hosts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true                # port 587
SMTP_SSL=false                    # set true (and STARTTLS false) for port 465
NOTIFY_ASYNC=true
SMTP_FROM=reception@example.com
WEBHOOK_URL=
WEBHOOK_SECRET=
